GRP_Main_Farm_Mob = Tabs.Main:AddLeftGroupbox("Farm Mob")
local function GetMobsFromCore()
    if Core and Core.GetMobs then return Core.GetMobs() end
    if getgenv().GetMobs then return getgenv().GetMobs() end
    local mobs = {}
    local isData = getgenv().IslandData or IslandData or (Core and Core.Island)
    if not isData then
        isData = World1 and (getgenv().Sea1_Islands or Sea1_Islands)
              or World2 and (getgenv().Sea2_Islands or Sea2_Islands)
              or World3 and (getgenv().Sea3_Islands or Sea3_Islands)
    end
    if isData then
        for _, is in pairs(isData) do
            if is.Mobs then
                for _, m in ipairs(is.Mobs) do
                    if not table.find(mobs, m) then
                        table.insert(mobs, m)
                    end
                end
            end
        end
        table.sort(mobs)
    end
    return mobs
end

